{
  "expo": {
    "name": "bud carrier",
    "slug": "bud-carrier",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#88aa99"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.freshman.bud",
      "buildNumber": "1",
      "jsEngine": "jsc",
      "config": {
        "usesNonExemptEncryption": false
      },
      "teamId": "5N36X2ZHR4"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#88aa99"
      },
      "package": "dev.freshman.bud",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font"
    ]
  }
}
